{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "vinplain": ["../src/index.ts"],
      "expo-modules-core": ["./tests/mocks/expo-modules-core.ts"]
    }
  },
  "include": ["index.ts", "tests"]
}
