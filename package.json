{
  "name": "vinplain",
  "version": "0.2.0",
  "description": "The public record, in plain code. Typed, keyless access to US vehicle data: VIN decode, NHTSA recalls, complaints, crash ratings, and EPA fuel economy.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "test:live": "RUN_LIVE=1 vitest run tests/live.smoke.test.ts",
    "example": "npm run build && node examples/basic.mjs",
    "prepack": "npm run build",
    "cli": "node bin/vinplain.mjs"
  },
  "keywords": [
    "vin",
    "vehicle",
    "nhtsa",
    "epa",
    "vpic",
    "recalls",
    "crash-ratings",
    "fuel-economy",
    "typescript",
    "no-api-key"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qadanm/vinplain.git"
  },
  "homepage": "https://github.com/qadanm/vinplain#readme",
  "bugs": {
    "url": "https://github.com/qadanm/vinplain/issues"
  },
  "bin": {
    "vinplain": "bin/vinplain.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
